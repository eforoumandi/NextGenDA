# NextGenDA external-runtime configuration example.
#
# This file contains examples only.
# Never commit your personal local environment file.

# Exact t-route source required by the release.
#
# scripts/setup_troute.py installs it automatically to:
#
#   ~/.local/share/nextgenda/t-route/dd43a7d218274c526306041369f4e5e8e76a2cb1
#
NEXTGENDA_T_ROUTE_SOURCE=/absolute/path/to/t-route

# Immutable public certified runtime.
NEXTGENDA_RUNTIME_IMAGE=ghcr.io/eforoumandi/nextgenda-runtime:sacsma-state-access-rc1@sha256:f4922762134e6a6b8ac5e9ec79fe451aaf0f0b8135269780a4c307435a7e9628
